* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: system-ui, -apple-system, sans-serif;
  background: #f6f3fc;
  color: #262233;
  line-height: 1.5;
}

header {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #ffffff;
  padding: 1.5rem;
  text-align: center;
}

.container {
  max-width: 960px;
  margin: 1.5rem auto;
  padding: 0 1rem;
  display: grid;
  gap: 1.25rem;
}

.card {
  background: #ffffff;
  border-radius: 14px;
  padding: 1.25rem;
  box-shadow: 0 6px 20px rgba(88, 56, 138, 0.08);
}

.card h2 {
  margin-bottom: 0.9rem;
  color: #5b21b6;
  font-size: 1.2rem;
}

form {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 1rem;
}

input {
  flex: 1 1 180px;
  padding: 0.65rem 0.8rem;
  border: 1px solid #d8d0ec;
  border-radius: 8px;
  font-size: 0.95rem;
}

button {
  padding: 0.65rem 1.1rem;
  border: none;
  border-radius: 8px;
  background: #7c3aed;
  color: #ffffff;
  font-weight: 600;
  cursor: pointer;
}

button:hover {
  background: #6d28d9;
}

ul {
  list-style: none;
  display: grid;
  gap: 0.5rem;
}

li {
  background: #faf7ff;
  border: 1px solid #ece4ff;
  padding: 0.65rem 0.85rem;
  border-radius: 8px;
}

.map-box {
  width: 100%;
  height: 300px;
  border-radius: 10px;
  background: #e9e2fa;
  margin-bottom: 0.9rem;
}

.chat-box {
  max-height: 260px;
  overflow-y: auto;
  border: 1px solid #ece4ff;
  background: #faf7ff;
  border-radius: 10px;
  padding: 0.8rem;
  margin-bottom: 0.8rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.msg-user {
  align-self: flex-end;
  background: #7c3aed;
  color: #ffffff;
  padding: 0.5rem 0.8rem;
  border-radius: 10px;
  max-width: 80%;
}

.msg-ai {
  align-self: flex-start;
  background: #ede9fe;
  color: #262233;
  padding: 0.5rem 0.8rem;
  border-radius: 10px;
  max-width: 80%;
}
